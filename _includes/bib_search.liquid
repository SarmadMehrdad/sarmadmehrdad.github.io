{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>

  <div class="pub-toolbar">
    <div class="pub-toolbar__search">
      <input
        id="bibsearch"
        class="bibsearch-form-input"
        type="text"
        placeholder="Search publications..."
        aria-label="Search publications"
      >
    </div>

    <div class="pub-toolbar__filter-header">
      <span class="pub-toolbar__label">Filter by topic</span>
      <button id="pub-clear-filters" class="pub-clear-filters" hidden>Clear filters</button>
    </div>
    <div id="pub-tag-filters" class="pub-tag-filters"></div>

    <div class="pub-toolbar__filter-header" style="margin-top: 0.9rem;">
      <span class="pub-toolbar__label">Filter by publication type</span>
    </div>
    <div id="pub-type-filters" class="pub-tag-filters"></div>
  </div>
{% endif %}
